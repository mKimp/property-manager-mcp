# Turso (libSQL) credentials — get these after provisioning at turso.tech
# turso db show <db-name> --url   → copy the libsql:// URL
# turso db tokens create <db-name> → copy the token

TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Local SQLite — only used by prisma migrate dev to generate SQL migration files
# The real database is Turso above; dev.db is never committed
LOCAL_DATABASE_URL=file:./dev.db
