# Point at the deployed backend URL (Render/Railway)
# Leave empty to use relative URLs (i.e., same origin via Vite proxy in dev)
VITE_API_BASE_URL=https://your-backend.onrender.com

# Shared API key — must match API_KEY set on the backend (Render env var).
# Leave empty in local dev (backend allows all requests when API_KEY is unset).
VITE_API_KEY=

# HTTP Basic Auth credentials — shown as browser login dialog on Vercel.
# Set both in Vercel env vars. Leave empty for local dev (no prompt shown).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
